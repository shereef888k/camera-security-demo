# ==============================================================================
# Camera Security Demonstration Backend — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual production/development values.
# NEVER commit the actual .env file or real credentials to Git!

# Server Port
PORT=4000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Telegram Bot API Credentials
# 1. Create a bot via @BotFather on Telegram to obtain TELEGRAM_BOT_TOKEN
# 2. Start a conversation with your bot (/start)
# 3. Obtain your numeric Telegram User ID (e.g. from @userinfobot) for TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_example
TELEGRAM_CHAT_ID=987654321

# Administrator Authentication Key
# Generate a cryptographically secure random string (e.g., openssl rand -hex 24)
ADMIN_API_KEY=replace_with_a_secure_random_admin_api_key_32_chars_or_more

# Allowed Frontend Origins for CORS (comma-separated or '*' for local testing)
# Example: https://yourusername.github.io,http://localhost:3000,http://localhost:5500
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,https://yourusername.github.io

# Persistent Database File Path (Optional, defaults to backend/data/sessions.db)
DATABASE_PATH=data/sessions.db
